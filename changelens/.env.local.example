# changelens 환경변수 — 이 파일을 .env.local로 복사해 값을 채운다.
#   cp .env.local.example .env.local
# .env.local은 .gitignore(.env*.local)에 걸려 커밋되지 않는다. 이 예시 파일에는 실제 값을 넣지 마라.
# 각 변수가 없을 때의 동작은 docs/ARCHITECTURE.md 「라우트와 환경변수」를 따른다.
# 선택 항목은 주석을 풀고 채운다 — 빈 값(KEY=)으로 두면 "없음"이 아니라 빈 문자열로 들어간다.

# --- 서버 전용 (NEXT_PUBLIC_ 접두사 금지) ---

# 필수. 세션 쿠키 서명 키 — 구글 값이 아니라 직접 만드는 랜덤 문자열이다. 없으면 서버가 뜨지 않는다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 선택. 커밋 요약용 Anthropic API 키. 없으면 요약 칸만 숨기고 나머지 화면은 그대로 동작한다.
# ANTHROPIC_API_KEY=

# 선택. 개발 중(npm run dev) 읽을 git 저장소 절대 경로. 없으면 process.cwd().
# bin/changelens.mjs로 띄우면 이 값은 쓰이지 않는다 — 인자로 받은 경로(없으면 실행 위치)가 들어간다.
# CHANGELENS_REPO=

# --- 클라이언트 공개값 ---

# 사실상 필수. Google Cloud Console의 OAuth 클라이언트 ID(웹 애플리케이션).
# 승인된 JavaScript 원본에 http://localhost:3000 과 http://localhost 를 둘 다 등록한다.
# 없으면 로그인 버튼이 비활성화된다. 빌드 때 코드에 박히므로 바꾸면 npm run build를 다시 돌린다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
