# jeonse-check 환경변수 예시
# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 모든 값은 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이지 마라(CLAUDE.md CRITICAL: 서비스키·DB는 src/server에서만).

# ---------------------------------------------------------------------------
# Database — PostgreSQL + Prisma (ADR-003, ADR-006)
# ---------------------------------------------------------------------------
# 로컬(Docker Postgres) 기본값. 로컬에서는 두 값이 같아도 된다.
#   docker run -d --name jeonse-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=jeonse_check -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jeonse_check"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jeonse_check"

# 운영(Supabase) — Supabase 대시보드 > Connect에서 복사한다.
# DATABASE_URL: 앱 런타임용. 풀러 transaction 모드(6543) + pgbouncer=true
# DIRECT_URL:   prisma migrate용. 직접 연결 또는 session 모드(5432)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth — Auth.js v5 + Google OAuth (ADR-002)
# ---------------------------------------------------------------------------
# 생성: npx auth secret  (또는 openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google (운영 도메인도 추가)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 운영에서 프록시 뒤에 배포할 때만 필요하다. 예: https://jeonse-check.example.com
# 로컬에서 npm run start(프로덕션 모드)로 띄울 때도 둘 중 하나가 없으면 UntrustedHost 오류가 난다(dev 모드는 불필요).
# AUTH_URL=""
# AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# 공공데이터포털(data.go.kr) — 실거래가·공시가격·건축물대장
# ---------------------------------------------------------------------------
# 계정 하나의 일반 인증키(Decoding)를 쓴다. API마다 활용신청은 따로 해야 한다:
#   - 국토교통부 아파트 전월세 실거래가 / 연립다세대 전월세 실거래가 (매매 실거래가도 필요 시)
#   - 국토교통부 건축HUB 건축물대장정보 서비스
# 공동주택 공시가격은 여기서 받지 않는다. 아래 디지털트윈국토 키를 쓴다.
DATA_GO_KR_SERVICE_KEY=""

# ---------------------------------------------------------------------------
# 공동주택 공시가격 — 국토교통부 디지털트윈국토 (www.vworld.kr)
# ---------------------------------------------------------------------------
# 디지털트윈국토 회원가입 > 인증키 발급에서 받는다. data.go.kr 서비스키와 별개다.
VWORLD_API_KEY=""
# 인증키 발급 때 입력한 서비스 URL(도메인). 키가 이 도메인에 묶여 있어 서버 호출에 domain 파라미터로 보낸다.
# 디지털트윈국토 > 마이페이지 > 인증키 관리에서 확인한 값을 그대로 적는다. 예: http://localhost:3000
VWORLD_API_DOMAIN=""

# ---------------------------------------------------------------------------
# 주소 정규화 — 행정안전부 도로명주소 검색 API (business.juso.go.kr)
# ---------------------------------------------------------------------------
# 지번↔도로명 변환, 법정동코드(LAWD_CD) 추출에 쓴다. 개발용 승인키는 발급 후 기간 제한이 있다.
JUSO_API_KEY=""
